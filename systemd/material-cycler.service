[Unit]
Description=Aura Material Cycler - Material You Wallpaper and Ambient Keyboard Sync
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/libexec/omarchy/harshith.aura-cycler-service-guard
Restart=on-failure
RestartSec=10
Nice=10
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=graphical-session.target default.target
