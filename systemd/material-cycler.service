[Unit]
Description=Material You Dynamic Wallpaper and ASUS Aura Sync
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/home/harshith/.local/bin/material-cycler run
Restart=always
RestartSec=5
Environment=PATH=/home/harshith/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=/run/user/1000

[Install]
WantedBy=graphical-session.target default.target
