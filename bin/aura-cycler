def log(msg):
    timestamp = time.strftime("%Y-%m-%d %H:%M:%S")
    formatted = f"[{timestamp}] {msg}"
    print(formatted)
    try:
        with open(LOG_FILE, "a") as f:
            f.write(formatted + "\n")
    except Exception:
        pass

def atomic_write_text(path, content, mode=0o644):
    """Write a generated config without exposing a half-written palette."""
    directory = os.path.dirname(path)
    os.makedirs(directory, exist_ok=True)
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w", encoding="utf-8", dir=directory,
            prefix=".material-cycler-", delete=False
        ) as f:
            temporary = f.name
            f.write(content)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        if temporary and os.path.exists(temporary):
            try:
                os.unlink(temporary)
            except OSError:
                pass

def atomic_copy_file(source, destination):
    with open(source, "rb") as f:
        data = f.read()
    directory = os.path.dirname(destination)
    os.makedirs(directory, exist_ok=True)
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(dir=directory, prefix=".material-cycler-", delete=False) as f:
            temporary = f.name
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(temporary, 0o644)
        os.replace(temporary, destination)
    finally:
        if temporary and os.path.exists(temporary):
            try:
                os.unlink(temporary)
            except OSError:
                pass

def load_config():
    cfg = dict(DEFAULT_CONFIG)
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                saved = json.load(f)
                cfg.update(saved)
        except Exception as e:
            log(f"Error reading config: {e}")
    # Sync with legacy files if they exist
    if os.path.exists(INTERVAL_FILE):
        try:
            with open(INTERVAL_FILE, "r") as f:
                val = int(f.read().strip())
                if val >= 5:
                    cfg["interval"] = val
        except Exception:
            pass
    if os.path.exists(BLUR_FILE):
        try:
            with open(BLUR_FILE, "r") as f:
                val = int(f.read().strip())
                cfg["blur"] = val
        except Exception:
            pass
    return cfg

def save_config(cfg):
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        atomic_write_text(CONFIG_FILE, json.dumps(cfg, indent=2))
        if "interval" in cfg:
            with open(INTERVAL_FILE, "w") as f:
                f.write(str(cfg["interval"]))
        if "blur" in cfg:
            with open(BLUR_FILE, "w") as f:
                f.write(str(cfg["blur"]))
    except Exception as e:
        log(f"Error saving config: {e}")

def get_location():
    cfg = load_config()
    loc = cfg.get("location_cache")
    now = time.time()
    if loc and (now - loc.get("timestamp", 0) < 21600):  # 6 hours
        return loc

    try:
        req = urllib.request.Request("http://ip-api.com/json", headers={"User-Agent": "AuraCycler/1.1"})
        with urllib.request.urlopen(req, timeout=2.5) as resp:
            data = json.loads(resp.read().decode())
            if data.get("status") == "success":
                loc = {
                    "lat": data.get("lat", 12.9753),
                    "lon": data.get("lon", 77.591),
                    "city": data.get("city", "Bengaluru"),
                    "country": data.get("country", "India"),
                    "timestamp": now
                }
                cfg["location_cache"] = loc
                save_config(cfg)
                return loc
    except Exception as e:
        log(f"Location lookup notice: {e}")

    return {"lat": 12.9753, "lon": 77.591, "city": "Bengaluru", "country": "India", "timestamp": now}

def get_weather(force=False):
    cfg = load_config()
    cached = cfg.get("weather_cache")
    now = time.time()
    if not force and cached and (now - cached.get("timestamp", 0) < 600):  # 10 mins
        return cached

    loc = get_location()
    lat = loc.get("lat", 12.9753)
    lon = loc.get("lon", 77.591)
    city = loc.get("city", "Bengaluru")

    try:
        url = f"https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}&current=temperature_2m,relative_humidity_2m,weather_code,is_day"
        req = urllib.request.Request(url, headers={"User-Agent": "AuraCycler/1.1"})
        with urllib.request.urlopen(req, timeout=3.0) as resp:
            data = json.loads(resp.read().decode())
            current = data.get("current", {})
            code = int(current.get("weather_code", 0))
            temp = float(current.get("temperature_2m", 22.0))
            is_day = bool(current.get("is_day", 1))

            meta = WMO_WEATHER_MAP.get(code)
            if meta:
                condition_label, day_icon, night_icon, night_topics, day_topics = meta
                icon = day_icon if is_day else night_icon
                topics = day_topics if is_day else night_topics
            else:
                condition_label = "Partly Cloudy"
                icon = "󰖕" if is_day else "󰖖"
                topics = ["landscape 4k", "nature 4k"]

            result = {
                "temp": round(temp),
                "condition": condition_label,
                "icon": icon,
                "code": code,
                "city": city,
                "is_day": is_day,
                "topics": topics,
                "timestamp": now
            }
            cfg["weather_cache"] = result
            save_config(cfg)
            return result
    except Exception as e:
        log(f"Weather lookup notice: {e}")
        if cached:
            return cached
        return {
            "temp": 23,
            "condition": "Pleasant",
            "icon": "󰖐",
            "code": 0,
            "city": city,
            "is_day": True,
            "topics": ["landscape 4k", "nature 4k"],
            "timestamp": now
        }

def get_wallhaven_key():
    env_key = os.environ.get("WALLHAVEN_API_KEY", "").strip()
    if env_key:
        return env_key
    if os.path.exists(WALLHAVEN_KEY_FILE):
        try:
            k = open(WALLHAVEN_KEY_FILE).read().strip()
            if k:
                return k
        except Exception:
            pass
    return ""

def valid_wallpaper(path, minimum=(2560, 1440)):
    """Reject invalid or compositor-unsafe images before publication."""
    try:
        from PIL import Image
        with Image.open(path) as image:
            width, height = image.size
            landscape = width >= minimum[0] and height >= minimum[1]
            portrait = width >= minimum[1] and height >= minimum[0]
            if not (landscape or portrait):
                return False
            if width * height > MAX_WALLPAPER_PIXELS:
                return False
            image.verify()
        return True
    except Exception:
        return False

def download_wallpaper(url, destination, minimum=(2560, 1440)):
    """Download to a same-directory temporary file, validate, then publish atomically."""
    os.makedirs(os.path.dirname(destination), exist_ok=True)
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(
            dir=os.path.dirname(destination),
            prefix=".material-download-",
            delete=False
        ) as f:
            temporary = f.name
            req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36"})
            with urllib.request.urlopen(req, timeout=15) as resp:
                shutil.copyfileobj(resp, f)
            f.flush()
            os.fsync(f.fileno())

        if not valid_wallpaper(temporary, minimum=minimum):
            log(f"Rejected downloaded image (failed validation/safety limits): {os.path.basename(destination)}")
            return False

        os.chmod(temporary, 0o644)
        os.replace(temporary, destination)
        return True
    except Exception as error:
        log(f"Atomic wallpaper download failed for {os.path.basename(destination)}: {error}")
        return False
    finally:
        if temporary and os.path.exists(temporary):
            try:
                os.unlink(temporary)
            except OSError:
                pass

def get_interval():
    cfg = load_config()
    return max(5, int(cfg.get("interval", 30)))

def set_interval(val):
    cfg = load_config()
    cfg["interval"] = max(5, int(val))
    save_config(cfg)
    log(f"Interval set to {val}s")

def get_keyboard_brightness():
    try:
        res = subprocess.run(["asusctl", "leds", "get"], capture_output=True, text=True, timeout=2)
        m = re.search(r"brightness:\s*(\w+)", res.stdout, re.IGNORECASE)
        if m:
            return m.group(1).lower()
    except Exception:
        pass
    return None

def set_keyboard_color(hex_code):
    global last_keyboard_level, last_keyboard_color
    clean_hex = str(hex_code).lstrip("#").upper()
    if not re.fullmatch(r"[0-9A-F]{6}", clean_hex):
        log(f"Skipped invalid keyboard color: {hex_code}")
        return False
    try:
        level = get_keyboard_brightness()
        if level == "off":
            last_keyboard_level = "off"
            last_keyboard_color = clean_hex
            log("Keyboard backlight is OFF; preserving the manual Off state and skipping Aura color write.")
            return False
        if level is None:
            log("Keyboard color sync skipped because ASUS keyboard state is unavailable.")
            return False
        if level == last_keyboard_level and clean_hex == str(last_keyboard_color or "").upper():
            return True

        os.makedirs(STATE_DIR, exist_ok=True)
        with open(KEYBOARD_LOCK_FILE, "a+") as lock_handle:
            try:
                fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                log("Keyboard sync locked by another write; skipping.")
                return False
            try:
                result = subprocess.run(
                    ["asusctl", "aura", "effect", "static", "--colour", clean_hex],
                    capture_output=True, text=True, timeout=3
                )
                if result.returncode != 0:
                    log(f"asusctl static returned non-zero ({result.returncode}): {result.stderr.strip() or result.stdout.strip()}")
                    return False
                last_keyboard_level = level
                last_keyboard_color = clean_hex
                log(f"ASUS Aura static color successfully synced to #{clean_hex} at brightness '{level}'.")
                return True
            finally:
                try:
                    fcntl.flock(lock_handle.fileno(), fcntl.LOCK_UN)
                except OSError:
                    pass
    except subprocess.TimeoutExpired:
        log("asusctl command timed out.")
        return False
    except FileNotFoundError:
        return False
    except Exception as e:
        log(f"ASUS Aura sync exception: {e}")
        return False

def get_blur():
    cfg = load_config()
    return int(cfg.get("blur", 12))

def set_blur(size):
    size = max(0, min(24, int(size)))
    cfg = load_config()
    cfg["blur"] = size
    save_config(cfg)
    try:
        subprocess.run(["omarchy-shell", "shell", "setBlur", str(size)], 
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
    except Exception:
        pass
    log(f"Glass blur set to {size}px")

def adjust_blur(delta):
    set_blur(get_blur() + delta)

def toggle_blur():
    cur = get_blur()
    set_blur(0 if cur > 0 else 12)

def collect_local_wallpapers():
    cfg = load_config()
    folders = cfg.get("custom_folders", [])
    paths = []
    seen = set()

    for folder in folders:
        expanded = os.path.expanduser(folder)
        if not os.path.exists(expanded):
            continue
        for root, _, files in os.walk(expanded):
            for f in sorted(files):
                if f.lower().endswith(IMAGE_EXTENSIONS):
                    candidate = os.path.join(root, f)
                    if candidate not in seen and valid_wallpaper(candidate):
                        paths.append(candidate)
                        seen.add(candidate)

    # Fallback to CACHE_DIR if no user images exist
    if not paths and os.path.exists(CACHE_DIR):
        for f in sorted(os.listdir(CACHE_DIR)):
            if f.lower().endswith(IMAGE_EXTENSIONS):
                candidate = os.path.join(CACHE_DIR, f)
                if candidate not in seen and valid_wallpaper(candidate):
                    paths.append(candidate)
                    seen.add(candidate)

    # Fallback to system themes directory
    if not paths:
        themes_dir = os.path.expanduser("~/.config/omarchy/themes")
        if os.path.exists(themes_dir):
            for root, _, files in os.walk(themes_dir):
                for f in sorted(files):
                    if f.lower().endswith(IMAGE_EXTENSIONS):
                        candidate = os.path.join(root, f)
                        if candidate not in seen and valid_wallpaper(candidate):
                            paths.append(candidate)
                            seen.add(candidate)

    return paths

def fetch_single_random_4k():
    """
    Fetches an authentic 4K/UHD (>=3840x2160) wallpaper.
    Adapts to outdoor live weather when weather_sync is enabled.
    """
    cfg = load_config()
    weather_sync = cfg.get("weather_sync", True)
    
    if weather_sync:
        try:
            weather = get_weather()
            topics = weather.get("topics", [])
            chosen_topic = random.choice(topics) if topics else random.choice(AESTHETIC_TOPICS)
            log(f"Weather sync ({weather.get('condition')}, {weather.get('temp')}°C): searching 4K '{chosen_topic}'")
        except Exception:
            chosen_topic = random.choice(AESTHETIC_TOPICS)
    else:
        chosen_topic = random.choice(AESTHETIC_TOPICS)
    
    # 1. Try Wallhaven 4K
    try:
        key = get_wallhaven_key()
        wh_url = f"https://wallhaven.cc/api/v1/search?q={urllib.parse.quote(chosen_topic)}&atleast=3840x2160&ratios=16x9,16x10&purity=100&sorting=random"
        headers = {"User-Agent": "Mozilla/5.0 (X11; Linux x86_64; rv:130.0) Gecko/20100101 Firefox/130.0"}
        if key:
            headers["X-API-Key"] = key
        req = urllib.request.Request(wh_url, headers=headers)
        with urllib.request.urlopen(req, timeout=7) as resp:
            data = json.loads(resp.read().decode())
            items = data.get("data", [])
            if items:
                item = random.choice(items[:6])
                photo_id = item.get("id")
                img_url = item.get("path")
                ext = ".png" if img_url.lower().endswith(".png") else ".jpg"
                dest = os.path.join(CACHE_DIR, f"wallhaven_{photo_id}{ext}")
                if not valid_wallpaper(dest):
                    download_wallpaper(img_url, dest)
                if valid_wallpaper(dest):
                    from PIL import Image
                    with Image.open(dest) as im:
                        log(f"Streamed 4K Wallhaven wallpaper: {os.path.basename(dest)} ({im.size[0]}x{im.size[1]}, {chosen_topic})")
                    return dest
    except Exception as e:
        log(f"Wallhaven 4K stream notice ({chosen_topic}): {e}")

    # 2. Fallback: Bing 4K UHD
    try:
        idx = random.randint(0, 7)
        bing_url = f"https://www.bing.com/HPImageArchive.aspx?format=js&idx={idx}&n=1&mkt=en-US&uhd=1&uhdwidth=3840&uhdheight=2160"
        req = urllib.request.Request(bing_url, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=6) as resp:
            data = json.loads(resp.read().decode())
            images = data.get("images", [])
            if images:
                img = images[0]
                hsh = img.get("hsh", str(idx))
                dest = os.path.join(CACHE_DIR, f"bing_{hsh}.jpg")
                if os.path.exists(dest) and valid_wallpaper(dest):
                    return dest
                img_url = "https://www.bing.com" + img["urlbase"] + "_UHD.jpg"
                if download_wallpaper(img_url, dest) and valid_wallpaper(dest):
                    log(f"Streamed Bing 4K UHD wallpaper: {os.path.basename(dest)}")
                    return dest
    except Exception as e:
        log(f"Bing 4K stream notice: {e}")

    return None

def fetch_4k_wallpapers(count=4):
    """Fetches a batch of 4K wallpapers into local cache."""
    os.makedirs(CACHE_DIR, exist_ok=True)
    downloaded = 0
    cfg = load_config()
    weather_sync = cfg.get("weather_sync", True)
    
    topics = list(AESTHETIC_TOPICS)
    if weather_sync:
        try:
            weather = get_weather()
            w_topics = weather.get("topics", [])
            if w_topics:
                topics = w_topics + topics
        except Exception:
            pass

    random.shuffle(topics)

    for topic in topics:
        if downloaded >= count:
            break
        try:
            key = get_wallhaven_key()
            wh_url = f"https://wallhaven.cc/api/v1/search?q={urllib.parse.quote(topic)}&atleast=3840x2160&ratios=16x9,16x10&purity=100&sorting=random"
            headers = {"User-Agent": "Mozilla/5.0"}
            if key:
                headers["X-API-Key"] = key
            req = urllib.request.Request(wh_url, headers=headers)
            with urllib.request.urlopen(req, timeout=7) as resp:
                data = json.loads(resp.read().decode())
                items = data.get("data", [])
                for item in items:
                    if downloaded >= count:
                        break
                    photo_id = item.get("id")
                    img_url = item.get("path")
                    ext = ".png" if img_url.lower().endswith(".png") else ".jpg"
                    dest = os.path.join(CACHE_DIR, f"wallhaven_{photo_id}{ext}")
                    if not os.path.exists(dest):
                        if download_wallpaper(img_url, dest):
                            log(f"Downloaded 4K wallpaper: {os.path.basename(dest)} ({topic})")
                            downloaded += 1
        except Exception:
            pass

    if downloaded < count:
        for idx in range(count - downloaded):
            try:
                bing_url = f"https://www.bing.com/HPImageArchive.aspx?format=js&idx={idx}&n=1&mkt=en-US&uhd=1&uhdwidth=3840&uhdheight=2160"
                req = urllib.request.Request(bing_url, headers={"User-Agent": "Mozilla/5.0"})
                with urllib.request.urlopen(req, timeout=6) as resp:
                    data = json.loads(resp.read().decode())
                    images = data.get("images", [])
                    if images:
                        img = images[0]
                        hsh = img.get("hsh", str(idx))
                        dest = os.path.join(CACHE_DIR, f"bing_{hsh}.jpg")
                        if not os.path.exists(dest):
                            img_url = "https://www.bing.com" + img["urlbase"] + "_UHD.jpg"
                            if download_wallpaper(img_url, dest) and valid_wallpaper(dest):
                                log(f"Downloaded Bing 4K UHD: {os.path.basename(dest)}")
                                downloaded += 1
            except Exception:
                pass

def extract_focal_colors_offline(image_path):
    """
    Offline Vision Model:
    Uses Pillow + NumPy + K-Means clustering + Google Material You Monet HCT.
    Filters background voids and scores clusters by chromaticity and focal presence.
    Returns (accent_hex, theme_palette).
    """
    try:
        from PIL import Image
        import numpy as np
        from sklearn.cluster import KMeans
        from materialyoucolor.hct import Hct
        from materialyoucolor.scheme.scheme_vibrant import SchemeVibrant
        from materialyoucolor.utils.color_utils import hex_from_argb
        
        img = Image.open(image_path).convert('RGB')
        img.thumbnail((200, 200), Image.Resampling.LANCZOS)
        arr = np.array(img).reshape(-1, 3) / 255.0
        
        r, g, b = arr[:, 0], arr[:, 1], arr[:, 2]
        max_c = np.maximum(np.maximum(r, g), b)
        min_c = np.minimum(np.minimum(r, g), b)
        chroma = max_c - min_c
        lightness = (max_c + min_c) / 2.0
        
        mask = (chroma > 0.15) & (lightness > 0.12) & (lightness < 0.92)
        vibrant_pixels = arr[mask]
        if len(vibrant_pixels) < 50:
            mask = (lightness > 0.10) & (lightness < 0.95)
            vibrant_pixels = arr[mask] if np.any(mask) else arr
            
        n_clusters = min(6, len(vibrant_pixels))
        kmeans = KMeans(n_clusters=n_clusters, random_state=42, n_init='auto')
        kmeans.fit(vibrant_pixels)
        
        counts = np.bincount(kmeans.labels_)
        best_score = -1
        best_color = kmeans.cluster_centers_[0]
        
        for i, center in enumerate(kmeans.cluster_centers_):
            cr, cg, cb = center
            c_max = max(cr, cg, cb)
            c_min = min(cr, cg, cb)
            c_chroma = c_max - c_min
            c_light = (c_max + c_min) / 2.0
            s = c_chroma / (1.0 - abs(2.0 * c_light - 1.0) + 1e-6)
            
            score = (counts[i] ** 0.5) * (s ** 1.4) * (c_chroma ** 0.8)
            if score > best_score:
                best_score = score
                best_color = center
                
        r_int = int(best_color[0] * 255)
        g_int = int(best_color[1] * 255)
        b_int = int(best_color[2] * 255)
        accent_hex = f"{r_int:02X}{g_int:02X}{b_int:02X}"
        
        argb = (0xFF << 24) | (r_int << 16) | (g_int << 8) | b_int
        hct = Hct.from_int(argb)
        scheme = SchemeVibrant(hct, False, 0.0)
        
        def hx(c_int):
            return hex_from_argb(c_int)[:7]
            
        p = scheme.primary_palette
        sc = scheme.secondary_palette
        t = scheme.tertiary_palette
        n = scheme.neutral_palette
        nv = scheme.neutral_variant_palette
        
        theme_palette = {
            'accent': f'#{accent_hex}',
            'selection': hx(p.tone(30)),
            'muted': hx(nv.tone(55)),
            'background': hx(n.tone(6)),
            'dark_background': hx(n.tone(4)),
            'darker_background': hx(n.tone(2)),
            'lighter_background': hx(n.tone(14)),
            'foreground': hx(n.tone(90)),
            'dark_foreground': hx(n.tone(70)),
            'light_foreground': hx(n.tone(95)),
            'bright_foreground': hx(n.tone(98)),
            'blue': hx(p.tone(80)),
            'cyan': hx(sc.tone(80)),
            'green': hx(t.tone(80)),
            'yellow': hx(sc.tone(90)),
            'orange': hx(p.tone(75)),
            'magenta': hx(t.tone(70)),
            'red': hx(scheme.error_palette.tone(80)),
            'bright_red': hx(scheme.error_palette.tone(85)),
            'bright_yellow': hx(sc.tone(95)),
            'bright_green': hx(t.tone(85)),
            'bright_blue': hx(p.tone(85)),
            'bright_magenta': hx(t.tone(75)),
            'bright_cyan': hx(sc.tone(85)),
            'brown': hx(p.tone(45)),
        }
        return accent_hex, theme_palette
    except Exception as e:
        log(f"Offline model extraction error: {e}")
        return None, None

def write_colors_toml(path, palette):
    try:
        content = f"""# Generated by Material You Monet Vision Model for Omarchy
mode = "dark"

accent = "{palette.get('accent', '#00FF66')}"
selection = "{palette.get('selection', '#1C251C')}"
muted = "{palette.get('muted', '#66696F')}"

background = "{palette.get('background', '#0A0E0A')}"
dark_background = "{palette.get('dark_background', '#060806')}"
darker_background = "{palette.get('darker_background', '#030403')}"
lighter_background = "{palette.get('lighter_background', '#182018')}"

foreground = "{palette.get('foreground', '#E2ECE2')}"
dark_foreground = "{palette.get('dark_foreground', '#A0ACA0')}"
light_foreground = "{palette.get('light_foreground', '#ECF6EC')}"
bright_foreground = "{palette.get('bright_foreground', '#F4FBF4')}"

red = "{palette.get('red', '#FFB4A3')}"
yellow = "{palette.get('yellow', '#E6E880')}"
orange = "{palette.get('orange', '#FFB787')}"
green = "{palette.get('green', '#80E89A')}"
cyan = "{palette.get('cyan', '#7DE7E8')}"
blue = "{palette.get('blue', '#80C2FF')}"
magenta = "{palette.get('magenta', '#E880E8')}"
brown = "{palette.get('brown', '#8A5E4D')}"

bright_red = "{palette.get('bright_red', '#FFDAD4')}"
bright_yellow = "{palette.get('bright_yellow', '#FFFFC0')}"
bright_green = "{palette.get('bright_green', '#A0FFBA')}"
bright_cyan = "{palette.get('bright_cyan', '#A0FFFF')}"
bright_blue = "{palette.get('bright_blue', '#A6D5FF')}"
bright_magenta = "{palette.get('bright_magenta', '#FFA6FF')}"
"""
        os.makedirs(os.path.dirname(path), exist_ok=True)
        atomic_write_text(path, content)
        return content
    except Exception as e:
        log(f"Error writing colors.toml to {path}: {e}")
        return ""

def regenerate_derived_theme_files(colors_raw):
    """Regenerate Omarchy's terminal, shell, border, and keyboard configs."""
    if not colors_raw:
        return False

    backup_root = None
    backup_next = None
    lock = None
    try:
        os.makedirs(CURRENT_THEME_DIR, exist_ok=True)
        os.makedirs(os.path.dirname(THEME_LOCK_FILE), exist_ok=True)
        lock = open(THEME_LOCK_FILE, "a+")
        fcntl.flock(lock, fcntl.LOCK_EX)

        if os.path.exists(NEXT_THEME_DIR):
            backup_root = tempfile.mkdtemp(
                prefix="omarchy-theme-next-",
                dir=os.path.dirname(NEXT_THEME_DIR)
            )
            backup_next = os.path.join(backup_root, "next-theme")
            os.replace(NEXT_THEME_DIR, backup_next)
        os.makedirs(NEXT_THEME_DIR, exist_ok=True)
        atomic_write_text(os.path.join(NEXT_THEME_DIR, "colors.toml"), colors_raw)

        template_env = os.environ.copy()
        template_env.setdefault("OMARCHY_PATH", os.path.expanduser("~/omarchy"))
        result = subprocess.run(
            ["omarchy-theme-set-templates"],
            capture_output=True, text=True, timeout=8, env=template_env
        )
        if result.returncode != 0:
            log("Omarchy theme template regeneration failed; keeping the current generated configs.")
            return False

        for name in THEME_TEMPLATE_FILES:
            source = os.path.join(NEXT_THEME_DIR, name)
            if os.path.isfile(source):
                atomic_copy_file(source, os.path.join(CURRENT_THEME_DIR, name))
        return True
    except Exception as e:
        log(f"Omarchy derived theme regeneration error: {e}")
        return False
    finally:
        if backup_next and not os.path.exists(NEXT_THEME_DIR):
            try:
                os.replace(backup_next, NEXT_THEME_DIR)
            except OSError:
                pass
        if backup_root:
            shutil.rmtree(backup_root, ignore_errors=True)
        if lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_UN)
                lock.close()
            except OSError:
                pass

def write_palette_state(image_path, accent_hex, palette, generated):
    state = {
        "version": 1,
        "wallpaper": os.path.realpath(image_path),
        "wallpaper_name": os.path.basename(image_path),
        "accent": f"#{accent_hex.lower()}",
        "keyboard": f"#{accent_hex.lower()}",
        "system_configs_regenerated": bool(generated),
        "palette": palette or {},
        "applied_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
    }
    try:
        atomic_write_text(PALETTE_STATE_FILE, json.dumps(state, indent=2, sort_keys=True) + "\n", 0o600)
    except Exception as e:
        log(f"Palette state write error: {e}")

def sync_current_keyboard_color():
    global last_keyboard_level, last_keyboard_color
    try:
        with open(PALETTE_STATE_FILE, "r", encoding="utf-8") as f:
            state = json.load(f)
        color = str(state.get("keyboard", "")).strip()
        level = get_keyboard_brightness()
        if not color or not re.fullmatch(r"#[0-9A-Fa-f]{6}", color):
            return
        if level != last_keyboard_level:
            previous = last_keyboard_level
            last_keyboard_level = level
            if level != "off" and level is not None:
                log(f"Keyboard brightness changed from {previous or 'unknown'} to {level}; applying current RGB {color}.")
                set_keyboard_color(color)
        elif level != "off" and color.upper() != str(last_keyboard_color or "").upper():
            set_keyboard_color(color)
    except (OSError, ValueError, TypeError):
        pass

def sleep_with_keyboard_sync(seconds):
    deadline = time.monotonic() + max(0, seconds)
    while True:
        sync_current_keyboard_color()
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return
        time.sleep(min(5, remaining))

def apply_next_wallpaper():
    cfg = load_config()
    chosen = None
    
    # 1. Stream fresh 4K wallpaper if stream_online is enabled (40% probability)
    if cfg.get("stream_online", True) and random.random() < 0.40:
        chosen = fetch_single_random_4k()

    # 2. Select from local wallpaper pool
    if not chosen:
        wallpapers = collect_local_wallpapers()
        if not wallpapers:
            log("No wallpapers found locally, fetching 4K batch...")
            fetch_4k_wallpapers(4)
            wallpapers = collect_local_wallpapers()
        if wallpapers:
            current_bg_link = os.path.expanduser("~/.local/state/omarchy/current/background")
            current_bg = os.path.realpath(current_bg_link) if os.path.exists(current_bg_link) else ""
            candidates = [w for w in wallpapers if w != current_bg]
            chosen = random.choice(candidates if candidates else wallpapers)

    if not chosen:
        log("No valid wallpaper available to apply.")
        return

    log(f"=== Applying New Wallpaper: {os.path.basename(chosen)} ===")

    # 3. Apply wallpaper atomically by updating Omarchy background symlink
    current_bg_link = os.path.expanduser("~/.local/state/omarchy/current/background")
    try:
        os.makedirs(os.path.dirname(current_bg_link), exist_ok=True)
        tmp_link = current_bg_link + ".tmp"
        if os.path.lexists(tmp_link):
            os.unlink(tmp_link)
        os.symlink(chosen, tmp_link)
        os.replace(tmp_link, current_bg_link)
    except Exception as e:
        log(f"Background symlink error: {e}")

    # 4. Extract focal colors and complete Material You palette via offline ML model
    focal_accent, palette = extract_focal_colors_offline(chosen)

    colors_raw = ""
    accent_hex = focal_accent or "00FF66"
    if palette:
        aether_colors = os.path.expanduser("~/.config/aether/theme/colors.toml")
        omarchy_colors = os.path.join(CURRENT_THEME_DIR, "colors.toml")
        colors_raw = write_colors_toml(aether_colors, palette)
        write_colors_toml(omarchy_colors, palette)

    generated = regenerate_derived_theme_files(colors_raw)
    write_palette_state(chosen, accent_hex, palette, generated)

    # 5. Apply complete theme and background transition live to Omarchy shell
    if colors_raw:
        try:
            b64 = base64.b64encode(colors_raw.encode()).decode()
            shell_path = os.path.join(CURRENT_THEME_DIR, "shell.toml")
            shell_raw = ""
            if os.path.isfile(shell_path):
                with open(shell_path, "r", encoding="utf-8") as f:
                    shell_raw = f.read()
            shell_b64 = base64.b64encode(shell_raw.encode()).decode()
            subprocess.run(["omarchy-shell", "-q", "background", "themeTransition", "", chosen, chosen, b64, shell_b64],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
            subprocess.run(["omarchy-shell", "-q", "shell", "applyTheme", b64, shell_b64],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
        except Exception:
            pass

    # 6. Re-apply glass blur
    try:
        subprocess.run(["omarchy-shell", "shell", "setBlur", str(get_blur())],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
    except Exception:
        pass

    # 7. ASUS Aura Keyboard Backlight Sync
    keyboard_hex = accent_hex or "00FF66"
    log(f"Canonical Accent: #{accent_hex} | ASUS Keyboard RGB: #{keyboard_hex}")
    set_keyboard_color(keyboard_hex)

    # 8. Live app sync: Chrome/Brave/Chromium policies, terminals, editors, and desktop apps
    try:
        subprocess.Popen(["omarchy-theme-set-browser"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.Popen(["omarchy-restart-terminal"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.Popen(["omarchy-theme-set-gnome"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.Popen(["omarchy-theme-set-foot"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.Popen(["omarchy-theme-set-tmux"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.Popen(["omarchy-restart-btop"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.Popen(["omarchy-theme-set-vscode"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.Popen(["omarchy-theme-set-obsidian"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.Popen(["omarchy-restart-opencode"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.Popen(["omarchy-restart-helix"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception as e:
        log(f"Live app theme sync notice: {e}")

def run_loop():
    log("Aura Material Cycler service started.")
    last_fetch = 0
    while True:
        try:
            apply_next_wallpaper()
            now = time.time()
            if now - last_fetch > 1800:
                last_fetch = now
                try:
                    fetch_4k_wallpapers(2)
                except Exception:
                    pass
        except Exception as e:
            log(f"Loop error: {e}")
        
        interval = get_interval()
        sleep_with_keyboard_sync(interval)

def start_daemon():
    res = subprocess.run(["systemctl", "--user", "start", "material-cycler.service"])
    if res.returncode == 0:
        print("Aura Material Cycler started successfully.")
    else:
        print("Failed to start service via systemd.")

def stop_daemon():
    res = subprocess.run(["systemctl", "--user", "stop", "material-cycler.service"])
    if res.returncode == 0:
        print("Aura Material Cycler stopped.")
    else:
        print("Failed to stop service.")

def toggle_daemon():
    res = subprocess.run(["systemctl", "--user", "is-active", "--quiet", "material-cycler.service"])
    if res.returncode == 0:
        stop_daemon()
    else:
        start_daemon()

def cycle_interval():
    steps = [15, 30, 60, 300, 600, 1800, 3600]
    cur = get_interval()
    try:
        idx = steps.index(cur)
        next_val = steps[(idx + 1) % len(steps)]
    except ValueError:
        next_val = 30
    set_interval(next_val)
    label = f"{next_val}s" if next_val < 60 else f"{next_val // 60}m"
    try:
        subprocess.run([
            "notify-send", "-a", "Aura Cycler",
            "-h", "string:x-canonical-private-synchronous:aura-cycler-speed",
            "Rotation Speed Updated",
            f"Wallpaper interval set to {label} ({next_val}s)"
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
    except Exception:
        pass
    print(f"Cycle interval updated to {next_val}s ({label}).")

def keyboard_policy(mode):
    """Apply an explicit user keyboard action without blocking later manual changes."""
    mode = str(mode or "").strip().lower()
    if mode in ("off", "lock"):
        subprocess.run(["asusctl", "leds", "set", "off"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
        print("Keyboard LEDs set to Off; wallpaper sync will not write while they are Off.")
    elif mode in ("allow", "on", "unlock"):
        print("Keyboard sync allows manual brightness changes; wallpaper sync never changes brightness.")
    else:
        print("Usage: aura-cycler keyboard {off|allow}")

def folder_cmd(args):
    cfg = load_config()
    folders = cfg.get("custom_folders", [])
    if not args or args[0] == "list":
        print("Configured Wallpaper Folders:")
        for idx, f in enumerate(folders, 1):
            exp = os.path.expanduser(f)
            count = 0
            if os.path.exists(exp):
                count = sum(1 for _, _, files in os.walk(exp) for file in files if file.lower().endswith(IMAGE_EXTENSIONS))
            print(f"  {idx}. {f} ({count} wallpapers)")
        return
    
    sub = args[0].lower()
    if sub == "add":
        if len(args) < 2:
            print("Usage: aura-cycler folder add <path>")
            return
        new_path = args[1].strip()
        exp = os.path.expanduser(new_path)
        if not os.path.exists(exp):
            print(f"Notice: Directory '{new_path}' does not exist on disk yet, added to rotation list.")
        if new_path not in folders:
            folders.append(new_path)
            cfg["custom_folders"] = folders
            save_config(cfg)
            print(f"Added folder: {new_path}")
        else:
            print(f"Folder is already configured: {new_path}")
    elif sub in ("remove", "rm", "delete"):
        if len(args) < 2:
            print("Usage: aura-cycler folder remove <path>")
            return
        target = args[1].strip()
        matched = False
        new_folders = []
        for f in folders:
            if f == target or os.path.expanduser(f) == os.path.expanduser(target):
                matched = True
            else:
                new_folders.append(f)
        if matched:
            cfg["custom_folders"] = new_folders
            save_config(cfg)
            print(f"Removed folder: {target}")
        else:
            print(f"Folder not found: {target}")
    else:
        print("Usage: aura-cycler folder {list|add <path>|remove <path>}")

def weather_toggle():
    cfg = load_config()
    current = cfg.get("weather_sync", True)
    cfg["weather_sync"] = not current
    save_config(cfg)
    status = "Enabled" if cfg["weather_sync"] else "Disabled"
    print(f"Weather-adaptive wallpaper sync: {status}")

def stream_toggle():
    cfg = load_config()
    current = cfg.get("stream_online", True)
    cfg["stream_online"] = not current
    save_config(cfg)
    status = "Enabled" if cfg["stream_online"] else "Disabled"
    print(f"Online 4K UHD streaming: {status}")

def status_json():
    res = subprocess.run(["systemctl", "--user", "is-active", "--quiet", "material-cycler.service"])
    active = (res.returncode == 0)
    cfg = load_config()
    wallpapers = collect_local_wallpapers()
    
    current_wp = ""
    current_wp_link = os.path.expanduser("~/.local/state/omarchy/current/background")
    if os.path.islink(current_wp_link):
        try:
            current_wp = os.path.realpath(current_wp_link)
        except Exception:
            pass
    elif os.path.exists(current_bg_link):
        current_wp = current_wp_link

    accent = "#00FF66"
    if os.path.exists(PALETTE_STATE_FILE):
        try:
            with open(PALETTE_STATE_FILE, "r", encoding="utf-8") as f:
                pdata = json.load(f)
                accent = pdata.get("accent") or pdata.get("keyboard") or "#00FF66"
        except Exception:
            pass

    weather_data = get_weather()

    state = {
        "active": active,
        "interval": cfg.get("interval", 30),
        "blur": cfg.get("blur", 12),
        "wallpaper": current_wp,
        "wallpaper_name": os.path.basename(current_wp) if current_wp else "Active",
        "accent": accent,
        "keyboard_brightness": get_keyboard_brightness() or "unknown",
        "weather": {
            "temp": weather_data.get("temp", 22),
            "condition": weather_data.get("condition", "Clear"),
            "icon": weather_data.get("icon", "󰖙"),
            "city": weather_data.get("city", "Bengaluru"),
            "code": weather_data.get("code", 0),
            "is_day": weather_data.get("is_day", True)
        },
        "weather_sync": cfg.get("weather_sync", True),
        "stream_online": cfg.get("stream_online", True),
        "custom_folders": cfg.get("custom_folders", []),
        "wallpapers_count": len(wallpapers)
    }
    print(json.dumps(state))

def status_daemon():
    res = subprocess.run(["systemctl", "--user", "is-active", "--quiet", "material-cycler.service"])
    wallpapers = collect_local_wallpapers()
    cfg = load_config()
    weather = get_weather()
    status_str = "active (running)" if res.returncode == 0 else "inactive (stopped)"
    print(f"● aura-cycler: {status_str} | Interval: {get_interval()}s | Blur: {get_blur()}px")
    print(f"  Available wallpaper pool: {len(wallpapers)} wallpapers across {len(cfg.get('custom_folders', []))} folders")
    print(f"  Live Weather: {weather.get('icon')} {weather.get('temp')}°C ({weather.get('condition')}, {weather.get('city')})")
    print(f"  Weather sync: {'Enabled' if cfg.get('weather_sync', True) else 'Disabled'} | Online 4K stream: {'Enabled' if cfg.get('stream_online', True) else 'Disabled'}")
    print(f"  ASUS Keyboard: brightness '{get_keyboard_brightness()}' (syncs only when on)")

if __name__ == "__main__":
    action = sys.argv[1] if len(sys.argv) > 1 else "start"
    if action == "run":
        run_loop()
    elif action == "start":
        start_daemon()
    elif action == "stop":
        stop_daemon()
    elif action == "toggle":
        toggle_daemon()
    elif action == "restart":
        stop_daemon()
        time.sleep(1)
        start_daemon()
    elif action == "status":
        status_daemon()
    elif action == "status-json":
        status_json()
    elif action == "next":
        apply_next_wallpaper()
    elif action in ("cycle-interval", "speed"):
        cycle_interval()
    elif action == "interval":
        if len(sys.argv) > 2 and sys.argv[2].isdigit():
            set_interval(int(sys.argv[2]))
            print(f"Cycle interval updated to {sys.argv[2]} seconds.")
        else:
            print(f"Current interval: {get_interval()} seconds. Usage: aura-cycler interval <seconds>")
    elif action == "blur":
        sub = sys.argv[2] if len(sys.argv) > 2 else "get"
        if sub == "up":
            adjust_blur(+3)
        elif sub == "down":
            adjust_blur(-3)
        elif sub == "toggle":
            toggle_blur()
        elif sub.isdigit():
            set_blur(int(sub))
        else:
            print(f"Current glass blur: {get_blur()}px. Usage: aura-cycler blur [up|down|toggle|<size>]")
    elif action == "fetch":
        fetch_4k_wallpapers(10)
    elif action == "keyboard":
        sub = sys.argv[2] if len(sys.argv) > 2 else "status"
        if sub in ("off", "lock", "allow", "on", "unlock"):
            keyboard_policy(sub)
        else:
            print(f"Keyboard brightness: {get_keyboard_brightness()}; color writes only when LEDs are already on")
            print("Usage: aura-cycler keyboard {off|allow}")
    elif action in ("weather-toggle", "toggle-weather"):
        weather_toggle()
    elif action in ("stream-toggle", "toggle-stream"):
        stream_toggle()
    elif action in ("folder", "folders"):
        folder_cmd(sys.argv[2:])
    else:
        print("Usage: aura-cycler {start|stop|toggle|restart|status|status-json|next|interval <sec>|blur [up|down|<px>]|weather-toggle|stream-toggle|folder {list|add|remove}|fetch|keyboard {off|allow}}")
