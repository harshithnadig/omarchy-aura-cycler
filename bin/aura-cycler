#!/home/harshith/.local/share/omarchy/aura-cycler-venv/bin/python
import os
import sys
import time
import json
import random
import signal
import subprocess
import colorsys
import re
import urllib.request
import urllib.parse
import base64

CACHE_DIR = os.path.expanduser("~/.local/share/omarchy/dynamic-wallpapers")
STATE_DIR = os.path.expanduser("~/.local/state/omarchy")
PID_FILE = os.path.join(STATE_DIR, "material-cycler.pid")
LOG_FILE = os.path.join(STATE_DIR, "material-cycler.log")
INTERVAL_FILE = os.path.join(STATE_DIR, "material-cycler-interval.txt")
BLUR_FILE = os.path.join(STATE_DIR, "glass-blur.txt")

KEY_LOCATIONS = [
    os.path.expanduser("~/.config/aura-cycler/unsplash.key"),
    os.path.expanduser("~/.config/omarchy/unsplash_key"),
]

os.makedirs(CACHE_DIR, exist_ok=True)
os.makedirs(STATE_DIR, exist_ok=True)

def get_unsplash_key():
    env_key = os.environ.get("UNSPLASH_ACCESS_KEY", "").strip()
    if env_key:
        return env_key
    for path in KEY_LOCATIONS:
        if os.path.exists(path):
            try:
                k = open(path).read().strip()
                if k:
                    return k
            except Exception:
                pass
    return ""

def log(msg):
    timestamp = time.strftime("%Y-%m-%d %H:%M:%S")
    formatted = f"[{timestamp}] {msg}"
    print(formatted)
    try:
        with open(LOG_FILE, "a") as f:
            f.write(formatted + "\n")
    except Exception:
        pass

def get_interval():
    try:
        if os.path.exists(INTERVAL_FILE):
            with open(INTERVAL_FILE, "r") as f:
                val = int(f.read().strip())
                if val >= 5:
                    return val
    except Exception:
        pass
    return 30

def set_interval(val):
    with open(INTERVAL_FILE, "w") as f:
        f.write(str(val))
    log(f"Interval set to {val}s")

def get_keyboard_brightness():
    try:
        res = subprocess.run(["asusctl", "leds", "get"], capture_output=True, text=True, timeout=2)
        m = re.search(r"brightness:\s*(\w+)", res.stdout, re.IGNORECASE)
        if m:
            return m.group(1).lower()
    except Exception:
        pass
    return None

def set_keyboard_color(hex_code):
    try:
        lvl = get_keyboard_brightness()
        if lvl == "off":
            log("Keyboard backlight is OFF, respecting manual user preference.")
            return

        clean_hex = hex_code.lstrip("#")
        subprocess.run(["asusctl", "aura", "effect", "static", "--colour", clean_hex], 
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
        
        # Verify hardware brightness was not overridden to high
        after_lvl = get_keyboard_brightness()
        if lvl and after_lvl and lvl != after_lvl:
            subprocess.run(["asusctl", "leds", "set", lvl], 
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
    except Exception as e:
        log(f"asusctl aura error: {e}")

# Apple Liquid Glass Blur Controller
def get_blur():
    try:
        if os.path.exists(BLUR_FILE):
            with open(BLUR_FILE, "r") as f:
                return int(f.read().strip())
    except Exception:
        pass
    return 12

def set_blur(size):
    size = max(0, min(30, int(size)))
    with open(BLUR_FILE, "w") as f:
        f.write(str(size))
    passes = 4 if size >= 8 else (3 if size >= 4 else 2)
    enabled = "true" if size > 0 else "false"
    cmd = f"hl.config({{ decoration = {{ blur = {{ enabled = {enabled}, size = {size}, passes = {passes} }} }} }})"
    subprocess.run(["hyprctl", "eval", cmd], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    pct = min(100, int((size / 24.0) * 100))
    try:
        subprocess.run([
            "notify-send", "-a", "Apple Liquid Glass",
            "-h", f"int:value:{pct}",
            "-h", "string:x-canonical-private-synchronous:blur-slider",
            "Apple Liquid Glass",
            f"Background Blur: {size}px ({pct}%)"
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
    except Exception:
        pass
    print(f"Liquid glass blur set to {size}px ({pct}%).")

def adjust_blur(delta):
    cur = get_blur()
    set_blur(cur + delta)

def toggle_blur():
    cur = get_blur()
    if cur > 0:
        set_blur(0)
    else:
        set_blur(14)

def collect_local_wallpapers():
    paths = []
    # Primary source: dynamic downloaded wallpapers
    if os.path.exists(CACHE_DIR):
        for f in os.listdir(CACHE_DIR):
            if f.lower().endswith(('.jpg', '.jpeg', '.png', '.webp')):
                paths.append(os.path.join(CACHE_DIR, f))
    # Secondary source: curated custom theme wallpapers
    themes_dir = os.path.expanduser("~/.config/omarchy/themes")
    if os.path.exists(themes_dir):
        for r, _, files in os.walk(themes_dir):
            for f in files:
                if f.lower().endswith(('.jpg', '.jpeg', '.png', '.webp')):
                    paths.append(os.path.join(r, f))
    return list(set(paths))

def fetch_single_random_unsplash():
    key = get_unsplash_key()
    if not key:
        return None
    queries = [
        "wallpapers", "nature", "landscape", "space", "cyberpunk",
        "anime", "scenery", "minimalist", "neon", "architecture", "japan"
    ]
    chosen_topic = random.choice(queries)
    url = f"https://api.unsplash.com/photos/random?orientation=landscape&query={chosen_topic}"
    try:
        req = urllib.request.Request(url, headers={
            "User-Agent": "Omarchy-Aura-Cycler/1.0",
            "Authorization": f"Client-ID {key}"
        })
        with urllib.request.urlopen(req, timeout=6) as resp:
            data = json.loads(resp.read().decode())
            photo_id = data.get("id")
            img_url = data.get("urls", {}).get("regular") or data.get("urls", {}).get("full")
            if photo_id and img_url:
                dest = os.path.join(CACHE_DIR, f"unsplash_{photo_id}.jpg")
                dl_req = urllib.request.Request(img_url, headers={"User-Agent": "Mozilla/5.0"})
                with urllib.request.urlopen(dl_req, timeout=8) as r_img:
                    with open(dest, "wb") as f:
                        f.write(r_img.read())
                log(f"Streamed random Unsplash wallpaper: unsplash_{photo_id} ({chosen_topic})")
                return dest
    except Exception as e:
        log(f"Unsplash stream error: {e}")
    return None

def fetch_unsplash_wallpapers(count=4):
    key = get_unsplash_key()
    topics = ["nature", "landscape", "wallpapers", "cartoons", "cyberpunk", "japan", "scenery"]
    chosen_topic = random.choice(topics)
    headers = {"User-Agent": "Omarchy-Aura-Cycler/1.0"}
    if key:
        headers["Authorization"] = f"Client-ID {key}"
        log(f"Calling Unsplash API ({chosen_topic})...")
    else:
        log(f"No Unsplash key found; using Wallhaven fallback ({chosen_topic})...")
    
    urls_to_download = []
    try:
        if key:
            url = f"https://api.unsplash.com/photos/random?count={count}&query={chosen_topic}&orientation=landscape"
            req = urllib.request.Request(url, headers=headers)
            with urllib.request.urlopen(req, timeout=6) as resp:
                data = json.loads(resp.read().decode())
                if isinstance(data, list):
                    for item in data:
                        img_url = item.get("urls", {}).get("regular") or item.get("urls", {}).get("full")
                        if img_url:
                            urls_to_download.append(("unsplash_" + item["id"], img_url))
        else:
            wh_url = f"https://wallhaven.cc/api/v1/search?q={urllib.parse.quote(chosen_topic)}&ratios=16x9,16x10"
            req2 = urllib.request.Request(wh_url, headers={"User-Agent": "Mozilla/5.0"})
            with urllib.request.urlopen(req2, timeout=5) as resp:
                d = json.loads(resp.read().decode())
                for item in d.get("data", [])[:count]:
                    urls_to_download.append(("wallhaven_" + item["id"], item["path"]))
    except Exception as e:
        log(f"Fetch error: {e}")

    for photo_id, url in urls_to_download:
        dest = os.path.join(CACHE_DIR, f"{photo_id}.jpg")
        if not os.path.exists(dest):
            try:
                dl_req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
                with urllib.request.urlopen(dl_req, timeout=8) as resp:
                    with open(dest, "wb") as f:
                        f.write(resp.read())
                log(f"Downloaded wallpaper: {photo_id}")
            except Exception as e:
                log(f"Failed to download {photo_id}: {e}")

def extract_focal_colors_offline(image_path):
    """
    Offline Vision Model:
    Uses Pillow + NumPy + K-Means clustering + Google Material You Monet HCT.
    Filters background voids (pure blacks, whites, washed-out grays)
    and scores clusters by chromaticity and focal presence.
    Returns (accent_hex, led_hex, full_theme_dict).
    """
    try:
        from PIL import Image
        import numpy as np
        from sklearn.cluster import KMeans
        from materialyoucolor.hct import Hct
        from materialyoucolor.scheme.scheme_vibrant import SchemeVibrant
        from materialyoucolor.utils.color_utils import hex_from_argb
        
        img = Image.open(image_path).convert('RGB')
        img.thumbnail((200, 200), Image.Resampling.LANCZOS)
        arr = np.array(img).reshape(-1, 3) / 255.0
        
        r, g, b = arr[:, 0], arr[:, 1], arr[:, 2]
        max_c = np.maximum(np.maximum(r, g), b)
        min_c = np.minimum(np.minimum(r, g), b)
        chroma = max_c - min_c
        lightness = (max_c + min_c) / 2.0
        
        # Saliency filter: isolate vibrant focal pixels
        mask = (chroma > 0.15) & (lightness > 0.12) & (lightness < 0.92)
        vibrant_pixels = arr[mask]
        if len(vibrant_pixels) < 50:
            mask = (lightness > 0.10) & (lightness < 0.95)
            vibrant_pixels = arr[mask] if np.any(mask) else arr
            
        n_clusters = min(6, len(vibrant_pixels))
        kmeans = KMeans(n_clusters=n_clusters, random_state=42, n_init='auto')
        kmeans.fit(vibrant_pixels)
        
        counts = np.bincount(kmeans.labels_)
        best_score = -1
        best_color = kmeans.cluster_centers_[0]
        
        for i, center in enumerate(kmeans.cluster_centers_):
            cr, cg, cb = center
            c_max = max(cr, cg, cb)
            c_min = min(cr, cg, cb)
            c_chroma = c_max - c_min
            c_light = (c_max + c_min) / 2.0
            s = c_chroma / (1.0 - abs(2.0 * c_light - 1.0) + 1e-6)
            
            # Saliency score: density^0.5 * saturation^1.4 * chroma^0.8
            score = (counts[i] ** 0.5) * (s ** 1.4) * (c_chroma ** 0.8)
            if score > best_score:
                best_score = score
                best_color = center
                
        r_int = int(best_color[0] * 255)
        g_int = int(best_color[1] * 255)
        b_int = int(best_color[2] * 255)
        accent_hex = f"{r_int:02X}{g_int:02X}{b_int:02X}"
        
        # High-chroma LED calibration
        h, l, s = colorsys.rgb_to_hls(best_color[0], best_color[1], best_color[2])
        calibrated_l = max(0.40, min(0.60, l))
        r_led, g_led, b_led = colorsys.hls_to_rgb(h, calibrated_l, min(0.98, max(0.85, s * 1.25)))
        led_hex = f"{int(r_led * 255):02X}{int(g_led * 255):02X}{int(b_led * 255):02X}"
        
        # Google Material You Monet full 16-color palette generation
        argb = (0xFF << 24) | (r_int << 16) | (g_int << 8) | b_int
        hct = Hct.from_int(argb)
        scheme = SchemeVibrant(hct, False, 0.0)
        
        def hx(c_int):
            return hex_from_argb(c_int)[:7]
            
        p = scheme.primary_palette
        sc = scheme.secondary_palette
        t = scheme.tertiary_palette
        n = scheme.neutral_palette
        nv = scheme.neutral_variant_palette
        
        theme_palette = {
            'accent': f'#{accent_hex}',
            'selection': hx(p.tone(30)),
            'muted': hx(nv.tone(55)),
            'background': hx(n.tone(6)),
            'dark_background': hx(n.tone(4)),
            'darker_background': hx(n.tone(2)),
            'lighter_background': hx(n.tone(14)),
            'foreground': hx(n.tone(90)),
            'dark_foreground': hx(n.tone(70)),
            'light_foreground': hx(n.tone(95)),
            'bright_foreground': hx(n.tone(98)),
            'blue': hx(p.tone(80)),
            'cyan': hx(sc.tone(80)),
            'green': hx(t.tone(80)),
            'yellow': hx(sc.tone(90)),
            'orange': hx(p.tone(75)),
            'magenta': hx(t.tone(70)),
            'red': hx(scheme.error_palette.tone(80)),
            'bright_red': hx(scheme.error_palette.tone(85)),
            'bright_green': hx(t.tone(85)),
            'bright_yellow': hx(sc.tone(95)),
            'bright_blue': hx(p.tone(85)),
            'bright_magenta': hx(t.tone(75)),
            'bright_cyan': hx(sc.tone(85)),
            'brown': hx(p.tone(45)),
        }
        return accent_hex, led_hex, theme_palette
    except Exception as e:
        log(f"Offline model extraction error: {e}")
        return None, None, None

def write_colors_toml(path, palette):
    try:
        content = f"""# Generated by Material You Monet Vision Model for Omarchy
mode = "dark"

accent = "{palette.get('accent', '#00FF66')}"
selection = "{palette.get('selection', '#1C251C')}"
muted = "{palette.get('muted', '#66696F')}"

background = "{palette.get('background', '#0A0E0A')}"
dark_background = "{palette.get('dark_background', '#060806')}"
darker_background = "{palette.get('darker_background', '#030403')}"
lighter_background = "{palette.get('lighter_background', '#182018')}"

foreground = "{palette.get('foreground', '#E2ECE2')}"
dark_foreground = "{palette.get('dark_foreground', '#A0ACA0')}"
light_foreground = "{palette.get('light_foreground', '#ECF6EC')}"
bright_foreground = "{palette.get('bright_foreground', '#F4FBF4')}"

red = "{palette.get('red', '#FFB4A3')}"
yellow = "{palette.get('yellow', '#E6E880')}"
orange = "{palette.get('orange', '#FFB787')}"
green = "{palette.get('green', '#80E89A')}"
cyan = "{palette.get('cyan', '#7DE7E8')}"
blue = "{palette.get('blue', '#80C2FF')}"
magenta = "{palette.get('magenta', '#E880E8')}"
brown = "{palette.get('brown', '#8A5E4D')}"

bright_red = "{palette.get('bright_red', '#FFDAD4')}"
bright_yellow = "{palette.get('bright_yellow', '#FFFFC0')}"
bright_green = "{palette.get('bright_green', '#A0FFBA')}"
bright_cyan = "{palette.get('bright_cyan', '#A0FFFF')}"
bright_blue = "{palette.get('bright_blue', '#A6D5FF')}"
bright_magenta = "{palette.get('bright_magenta', '#FFA6FF')}"
"""
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as f:
            f.write(content)
        return content
    except Exception as e:
        log(f"Error writing colors.toml to {path}: {e}")
        return ""

def apply_next_wallpaper():
    chosen = None
    # 1. Randomly stream fresh wallpaper from Unsplash with 75% probability
    if random.random() < 0.75:
        chosen = fetch_single_random_unsplash()

    # If stream didn't run or failed, select randomly from local pool
    if not chosen:
        wallpapers = collect_local_wallpapers()
        if not wallpapers:
            log("No wallpapers found locally, fetching batch...")
            fetch_unsplash_wallpapers(3)
            wallpapers = collect_local_wallpapers()
        if wallpapers:
            current_bg_link = os.path.expanduser("~/.local/state/omarchy/current/background")
            current_bg = os.path.realpath(current_bg_link) if os.path.exists(current_bg_link) else ""
            choices = [w for w in wallpapers if os.path.realpath(w) != current_bg] or wallpapers
            chosen = random.choice(choices)

    if not chosen:
        log("No wallpaper available to apply.")
        return

    log(f"=== Applying New Wallpaper: {os.path.basename(chosen)} ===")

    # 2. Update Omarchy wallpaper immediately with crossfade IPC
    try:
        subprocess.run(["omarchy-theme-bg-set", chosen], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=4)
    except Exception as e:
        log(f"Wallpaper set error: {e}")

    # 3. Extract focal colors and complete Material You palette via offline ML model
    focal_accent, focal_led, palette = extract_focal_colors_offline(chosen)

    colors_raw = ""
    accent_hex = focal_accent or "00FF66"
    if palette:
        aether_colors = os.path.expanduser("~/.config/aether/theme/colors.toml")
        omarchy_colors = os.path.expanduser("~/.local/state/omarchy/current/theme/colors.toml")
        colors_raw = write_colors_toml(aether_colors, palette)
        write_colors_toml(omarchy_colors, palette)

    # 4. Apply complete theme live to Omarchy shell
    if colors_raw:
        try:
            b64 = base64.b64encode(colors_raw.encode()).decode()
            subprocess.run(["omarchy-shell", "shell", "applyTheme", b64, ""], 
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
        except Exception:
            pass

    # 5. Refresh Hyprland window borders to match the new accent
    try:
        subprocess.run(["omarchy-restart-hyprctl"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
    except Exception:
        pass

    # 6. ASUS Aura Keyboard Backlight Sync (Maintains user's brightness level)
    led_hex = focal_led or "00FF66"
    log(f"Theme Accent: #{accent_hex} | ASUS Keyboard Aura LED: #{led_hex}")
    set_keyboard_color(led_hex)

    # 7. Send synchronized desktop notification
    try:
        wp_title = os.path.basename(chosen)
        subprocess.run([
            "notify-send", "-a", "Aura Cycler",
            "-h", "string:x-canonical-private-synchronous:aura-cycler-wp",
            "-i", chosen,
            "Wallpaper & Theme Synced",
            f"{wp_title}\nAccent: #{accent_hex}  |  ASUS Aura: #{led_hex}"
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
    except Exception:
        pass

def run_loop():
    log("Material Cycler service started.")
    last_fetch = 0
    # Apply initial blur setting
    set_blur(get_blur())
    while True:
        try:
            apply_next_wallpaper()
            now = time.time()
            if now - last_fetch > 600:
                last_fetch = now
                try:
                    fetch_unsplash_wallpapers(3)
                except Exception:
                    pass
        except Exception as e:
            log(f"Loop error: {e}")
        
        interval = get_interval()
        time.sleep(interval)

def start_daemon():
    res = subprocess.run(["systemctl", "--user", "start", "material-cycler.service"])
    if res.returncode == 0:
        print(f"material-cycler service started via systemd (interval {get_interval()}s).")
    else:
        print("Failed to start material-cycler service.")

def stop_daemon():
    res = subprocess.run(["systemctl", "--user", "stop", "material-cycler.service"])
    if res.returncode == 0:
        print("material-cycler service stopped via systemd.")
    else:
        print("Failed to stop material-cycler service.")

def toggle_daemon():
    res = subprocess.run(["systemctl", "--user", "is-active", "--quiet", "material-cycler.service"])
    if res.returncode == 0:
        subprocess.run(["systemctl", "--user", "stop", "material-cycler.service"])
        try:
            subprocess.run([
                "notify-send", "-a", "Aura Cycler",
                "-h", "string:x-canonical-private-synchronous:aura-cycler-status",
                "Aura Cycler Paused",
                "Background rotation paused.\nShortcut: Super+Alt+P to resume."
            ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
        except Exception:
            pass
        print("material-cycler paused.")
    else:
        subprocess.run(["systemctl", "--user", "start", "material-cycler.service"])
        interval = get_interval()
        try:
            subprocess.run([
                "notify-send", "-a", "Aura Cycler",
                "-h", "string:x-canonical-private-synchronous:aura-cycler-status",
                "Aura Cycler Resumed",
                f"Auto rotation active (every {interval}s).\nShortcut: Super+Alt+P to pause."
            ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
        except Exception:
            pass
        print(f"material-cycler resumed (interval {interval}s).")

def cycle_interval():
    cur = get_interval()
    steps = [15, 30, 60, 300, 600]
    if cur in steps:
        next_val = steps[(steps.index(cur) + 1) % len(steps)]
    else:
        next_val = 30
    set_interval(next_val)
    label = f"{next_val}s" if next_val < 60 else f"{next_val // 60}m"
    try:
        subprocess.run([
            "notify-send", "-a", "Aura Cycler",
            "-h", "string:x-canonical-private-synchronous:aura-cycler-interval",
            "Rotation Speed Changed",
            f"Now cycling every {label} ({next_val}s).\nShortcut: Super+Alt+I to cycle speed."
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
    except Exception:
        pass
    print(f"Cycle interval updated to {next_val}s ({label}).")

def status_daemon():
    res = subprocess.run(["systemctl", "--user", "is-active", "--quiet", "material-cycler.service"])
    wallpapers = collect_local_wallpapers()
    if res.returncode == 0:
        print(f"● material-cycler.service is active (running, interval {get_interval()}s)")
        print(f"  Available wallpaper pool: {len(wallpapers)} wallpapers")
        print(f"  Current background blur: {get_blur()}px")
        print(f"  Keyboard backlight brightness: {get_keyboard_brightness()}")
    else:
        print(f"○ material-cycler.service is inactive (stopped).")
        print(f"  Available wallpaper pool: {len(wallpapers)} wallpapers")
        print(f"  Current background blur: {get_blur()}px")

if __name__ == "__main__":
    action = sys.argv[1] if len(sys.argv) > 1 else "start"
    if action == "run":
        run_loop()
    elif action == "start":
        start_daemon()
    elif action == "stop":
        stop_daemon()
    elif action == "toggle":
        toggle_daemon()
    elif action == "restart":
        stop_daemon()
        time.sleep(1)
        start_daemon()
    elif action == "status":
        status_daemon()
    elif action == "next":
        apply_next_wallpaper()
    elif action in ("cycle-interval", "speed"):
        cycle_interval()
    elif action == "interval":
        if len(sys.argv) > 2 and sys.argv[2].isdigit():
            set_interval(int(sys.argv[2]))
            print(f"Cycle interval updated to {sys.argv[2]} seconds.")
        else:
            print(f"Current interval: {get_interval()} seconds. Usage: material-cycler interval <seconds>")
    elif action == "blur":
        sub = sys.argv[2] if len(sys.argv) > 2 else "get"
        if sub == "up":
            adjust_blur(+3)
        elif sub == "down":
            adjust_blur(-3)
        elif sub == "toggle":
            toggle_blur()
        elif sub.isdigit():
            set_blur(int(sub))
        else:
            print(f"Current glass blur: {get_blur()}px. Usage: material-cycler blur [up|down|toggle|<size>]")
    elif action == "fetch":
        fetch_unsplash_wallpapers(10)
    else:
        print("Usage: material-cycler {start|stop|toggle|restart|status|next|cycle-interval|interval <sec>|blur [up|down|<px>]|fetch}")
