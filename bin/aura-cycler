#!/usr/bin/env python3
"""Stable public entrypoint for Aura Material Cycler v1.4.

All launches pass through this file so configuration migrations, locking,
recovery and maintenance policy cannot be bypassed accidentally.
"""

import importlib.util
import json
import os
import sys
from importlib.machinery import SourceFileLoader
from pathlib import Path

HERE = Path(__file__).resolve().parent
PUBLIC_PATH = Path(__file__).resolve()
CONTROL_PATH = HERE / "aura-cycler-control"
CONFIG_LAYER_PATH = HERE / "aura-config.py"
MAX_LOG_BYTES = 2 * 1024 * 1024
LOG_BACKUPS = 2


def _load(name, path):
    if not path.is_file():
        raise SystemExit(f"Aura component is missing: {path}")
    loader = SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


control = _load("aura_cycler_control", CONTROL_PATH)
config_layer = _load("aura_cycler_config", CONFIG_LAYER_PATH)

# Omarchy historically stores shell.json under ~/.config/omarchy even on some
# setups that otherwise use XDG_CONFIG_HOME. Prefer the config-layer XDG lookup,
# then fall back to the standard Omarchy path so native settings remain usable
# on both layouts without changing Aura's own XDG-aware state paths.
_original_shell_explicit_settings = config_layer._shell_explicit_settings


def _standard_shell_fallback(active_control):
    explicit = _original_shell_explicit_settings(active_control)
    if explicit:
        return explicit

    standard = Path(active_control.runtime.HOME) / ".config" / "omarchy" / "shell.json"
    xdg = Path(active_control.runtime.XDG_CONFIG_HOME) / "omarchy" / "shell.json"
    if standard == xdg or not standard.is_file():
        return {}
    try:
        data = json.loads(standard.read_text(encoding="utf-8"))
        layout = data.get("bar", {}).get("layout", {})
        for section in ("left", "center", "right"):
            entries = layout.get(section, [])
            if not isinstance(entries, list):
                continue
            for entry in entries:
                if isinstance(entry, dict) and entry.get("id") == config_layer.PLUGIN_ID:
                    return {
                        key: entry[key]
                        for key in config_layer.NATIVE_SETTING_KEYS
                        if key in entry
                    }
    except (OSError, ValueError, TypeError, AttributeError):
        return {}
    return {}


config_layer._shell_explicit_settings = _standard_shell_fallback

# Detached-daemon identity must remain the public entrypoint even though the
# feature/control implementations are import-only layers.
control.FRONT_PATH = PUBLIC_PATH
control.runtime.WRAPPER_PATH = PUBLIC_PATH
config_layer.install(control)


def _install_bounded_logging(active_control):
    """Keep Aura's private log bounded without changing the preserved engine."""
    core = active_control.core
    original_log = core.log
    log_path = Path(core.LOG_FILE)
    lock_path = log_path.with_suffix(log_path.suffix + ".lock")

    def bounded_log(message):
        lock_handle = None
        try:
            log_path.parent.mkdir(parents=True, exist_ok=True)
            fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
            os.fchmod(fd, 0o600)
            lock_handle = os.fdopen(fd, "a+")
            core.fcntl.flock(lock_handle.fileno(), core.fcntl.LOCK_EX)
            if log_path.is_file() and log_path.stat().st_size >= MAX_LOG_BYTES:
                oldest = Path(str(log_path) + f".{LOG_BACKUPS}")
                try:
                    oldest.unlink()
                except FileNotFoundError:
                    pass
                for index in range(LOG_BACKUPS - 1, 0, -1):
                    source = Path(str(log_path) + f".{index}")
                    target = Path(str(log_path) + f".{index + 1}")
                    if source.exists():
                        os.replace(source, target)
                os.replace(log_path, Path(str(log_path) + ".1"))
            original_log(message)
        except OSError:
            original_log(message)
        finally:
            if lock_handle is not None:
                try:
                    core.fcntl.flock(lock_handle.fileno(), core.fcntl.LOCK_UN)
                except OSError:
                    pass
                lock_handle.close()

    core.log = bounded_log


_install_bounded_logging(control)

# Preserve the import surface used by Aura's regression tests and existing
# helper scripts. The public file remains small; implementation lives in the
# control/runtime layers.
for _name in dir(control):
    if not _name.startswith("__"):
        globals().setdefault(_name, getattr(control, _name))


def main():
    argv = sys.argv[1:]
    if argv and argv[0] == "reset" and "--yes" not in argv[1:]:
        print(
            "Refusing destructive reset without --yes. "
            "Use: aura-cycler reset --yes [--keep-favorites] [--keep-folders]"
        )
        return 2
    handled = config_layer.dispatch(control, argv)
    if handled is not None:
        return handled
    return control._dispatch()


if __name__ == "__main__":
    raise SystemExit(main())
