#!/usr/bin/env python3
"""Stable public entrypoint for Aura Material Cycler v1.4.

All launches pass through this file so configuration migrations, locking,
recovery and maintenance policy cannot be bypassed accidentally.
"""

import importlib.util
import sys
from importlib.machinery import SourceFileLoader
from pathlib import Path

HERE = Path(__file__).resolve().parent
PUBLIC_PATH = Path(__file__).resolve()
CONTROL_PATH = HERE / "aura-cycler-control"
CONFIG_LAYER_PATH = HERE / "aura-config.py"


def _load(name, path):
    if not path.is_file():
        raise SystemExit(f"Aura component is missing: {path}")
    loader = SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


control = _load("aura_cycler_control", CONTROL_PATH)
config_layer = _load("aura_cycler_config", CONFIG_LAYER_PATH)

# Detached-daemon identity must remain the public entrypoint even though the
# feature/control implementations are import-only layers.
control.FRONT_PATH = PUBLIC_PATH
control.runtime.WRAPPER_PATH = PUBLIC_PATH
config_layer.install(control)

# Preserve the import surface used by Aura's regression tests and existing
# helper scripts. The public file remains tiny; implementation lives in the
# control/runtime layers.
for _name in dir(control):
    if not _name.startswith("__"):
        globals().setdefault(_name, getattr(control, _name))


def main():
    handled = config_layer.dispatch(control, sys.argv[1:])
    if handled is not None:
        return handled
    return control._dispatch()


if __name__ == "__main__":
    raise SystemExit(main())
