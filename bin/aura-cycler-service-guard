#!/usr/bin/env python3
"""Run Aura only after validating the installed plugin checkout."""

import json
import os
import stat
import subprocess
from pathlib import Path


PLUGIN_ID = "harshith.aura-cycler"
SERVICE_NAME = "material-cycler.service"
PLUGIN_ROOT = (
    Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    / "omarchy" / "plugins" / PLUGIN_ID
)
ENTRYPOINT = PLUGIN_ROOT / "bin" / "aura-cycler"
UNIT_PATH = (
    Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    / "systemd" / "user" / SERVICE_NAME
)
UNIT_EXEC_MARKER = "%h/.local/libexec/omarchy/harshith.aura-cycler-service-guard"


def _path_has_no_symlinks(path):
    """Check every existing component without following symlinks."""
    path = Path(path)
    if not path.is_absolute():
        return False
    current = Path(path.anchor)
    for component in path.parts[1:]:
        current /= component
        try:
            if stat.S_ISLNK(os.lstat(current).st_mode):
                return False
        except OSError:
            return False
    return True


def _owned_directory(path):
    if not _path_has_no_symlinks(path):
        return False
    try:
        metadata = os.lstat(path)
    except OSError:
        return False
    return stat.S_ISDIR(metadata.st_mode) and metadata.st_uid == os.getuid()


def _owned_regular_file(path, executable=False):
    if not _path_has_no_symlinks(path):
        return False
    try:
        metadata = os.lstat(path)
    except OSError:
        return False
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid():
        return False
    return not executable or bool(metadata.st_mode & stat.S_IXUSR)


def plugin_checkout_is_valid():
    """Require the expected plugin id and an owner-controlled real entrypoint."""
    if not _owned_directory(PLUGIN_ROOT):
        return False
    if not _owned_directory(PLUGIN_ROOT / "bin"):
        return False
    manifest = PLUGIN_ROOT / "manifest.json"
    if not _owned_regular_file(manifest):
        return False
    if not _owned_regular_file(ENTRYPOINT, executable=True):
        return False
    try:
        with manifest.open(encoding="utf-8") as handle:
            return json.load(handle).get("id") == PLUGIN_ID
    except (OSError, ValueError, AttributeError, TypeError):
        return False


def owned_unit_is_present():
    """Only remove a unit copied by Aura's documented installer."""
    if not _owned_regular_file(UNIT_PATH):
        return False
    try:
        unit_text = UNIT_PATH.read_text(encoding="utf-8")
    except OSError:
        return False
    return any(
        line.strip() == f"ExecStart={UNIT_EXEC_MARKER}"
        for line in unit_text.splitlines()
    )


def _remove_owned_enable_links():
    """Remove only enablement links that point at Aura's exact unit path."""
    unit_path = os.path.abspath(os.fspath(UNIT_PATH))
    for wants_directory in (
        "graphical-session.target.wants",
        "default.target.wants",
    ):
        link = UNIT_PATH.parent / wants_directory / SERVICE_NAME
        try:
            if not stat.S_ISLNK(os.lstat(link).st_mode):
                continue
            target = os.readlink(link)
            resolved_target = os.path.abspath(
                os.path.join(os.fspath(link.parent), target)
            )
            if resolved_target == unit_path:
                link.unlink()
        except OSError:
            continue


def remove_owned_unit():
    """Disable future starts and remove only Aura's own unit file."""
    if not owned_unit_is_present():
        return

    # Disable while the unit file still exists so systemd can remove its
    # enablement links. The explicit link cleanup below is a safe fallback
    # when systemd is unavailable or the unit is already partially removed.
    try:
        subprocess.run(
            ["systemctl", "--user", "disable", SERVICE_NAME],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=5,
        )
    except (FileNotFoundError, OSError, subprocess.TimeoutExpired):
        pass

    try:
        UNIT_PATH.unlink()
    except OSError:
        return

    _remove_owned_enable_links()
    for command in (
        ["systemctl", "--user", "daemon-reload"],
    ):
        try:
            subprocess.run(
                command,
                check=False,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=5,
            )
        except (FileNotFoundError, OSError, subprocess.TimeoutExpired):
            pass


def main():
    if not plugin_checkout_is_valid():
        remove_owned_unit()
        return 0
    os.execv(str(ENTRYPOINT), [str(ENTRYPOINT), "run"])
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
