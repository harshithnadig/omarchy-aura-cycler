#!/usr/bin/env python3
"""Aura Material Cycler v1.4 control plane.

This entrypoint intentionally stays small. The hardened compatibility/runtime
layer lives in ``aura-cycler-runtime`` and the original feature engine lives in
``aura-cycler-core``. Keeping those layers separate makes failures easier to
bisect on real Omarchy systems while allowing user-facing state features to be
implemented without destabilising wallpaper/theme internals.
"""

import contextlib
import copy
import importlib.util
import io
import json
import os
import shutil
import subprocess
import sys
import time
from importlib.machinery import SourceFileLoader
from pathlib import Path

FRONT_PATH = Path(__file__).resolve()
HERE = FRONT_PATH.parent
RUNTIME_PATH = HERE / "aura-cycler-runtime"
VERSION = "1.4.2"

if not RUNTIME_PATH.is_file():
    raise SystemExit(f"Aura runtime is missing: {RUNTIME_PATH}")

_loader = SourceFileLoader("aura_cycler_runtime", str(RUNTIME_PATH))
_spec = importlib.util.spec_from_loader(_loader.name, _loader)
runtime = importlib.util.module_from_spec(_spec)
_loader.exec_module(runtime)

# The hardened runtime uses WRAPPER_PATH when starting the detached daemon and
# validating its PID. Keep the public control-plane entrypoint as that stable
# process identity even though the implementation is layered.
runtime.WRAPPER_PATH = FRONT_PATH
core = runtime.core

# Preserve import-level compatibility for the existing regression tests and for
# anyone importing the script as a module. New names defined below win.
for _name in dir(runtime):
    if not _name.startswith("__"):
        globals().setdefault(_name, getattr(runtime, _name))

STATE_DIR = Path(runtime.AURA_STATE_DIR)
CACHE_DIR = Path(runtime.AURA_CACHE_DIR)
HISTORY_FILE = STATE_DIR / "aura-history.json"
FAVORITES_FILE = STATE_DIR / "aura-favorites.json"
HISTORY_LIMIT = 100
VALID_THEME_SCOPES = ("shell", "terminals", "editors", "all")

SCENES = {
    "focus": {
        "interval": 1800,
        "stream_online": False,
        "screen_effects": False,
        "keyboard_sync": True,
        "theme_scope": "shell",
    },
    "gaming": {
        "interval": 3600,
        "stream_online": False,
        "screen_effects": False,
        "theme_scope": "shell",
        "gpu_guard.auto_protect": True,
    },
    "battery": {
        "interval": 3600,
        "stream_online": False,
        "screen_effects": False,
        "keyboard_sync": False,
        "theme_scope": "shell",
    },
    "ambient": {
        "interval": 300,
        "screen_effects": True,
        "keyboard_sync": True,
        "theme_scope": "all",
    },
}


def _read_json(path, fallback):
    try:
        return json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, ValueError, TypeError):
        return copy.deepcopy(fallback)


def _write_private_json(path, value):
    Path(path).parent.mkdir(parents=True, exist_ok=True)
    core.atomic_write_text(str(path), json.dumps(value, indent=2, sort_keys=True) + "\n", 0o600)


def _current_wallpaper():
    candidates = (
        Path(runtime.AURA_STATE_DIR) / "current/background",
        Path(runtime.HOME) / ".local/state/omarchy/current/background",
    )
    for candidate in candidates:
        try:
            if candidate.is_symlink():
                return os.path.realpath(candidate)
            if candidate.is_file():
                return str(candidate.resolve())
        except OSError:
            continue
    return ""


def _palette_meta():
    data = _read_json(core.PALETTE_STATE_FILE, {})
    return {"accent": data.get("accent", ""), "applied_at": data.get("applied_at", "")}


def _load_history():
    data = _read_json(HISTORY_FILE, {"version": 1, "items": []})
    items = data.get("items", []) if isinstance(data, dict) else []
    return [item for item in items if isinstance(item, dict) and item.get("path")]


def _save_history(items):
    _write_private_json(HISTORY_FILE, {"version": 1, "items": items[-HISTORY_LIMIT:]})


def _record_history(path=None):
    chosen = path or _current_wallpaper()
    path = os.path.realpath(chosen) if chosen else ""
    if not path:
        return False
    items = _load_history()
    if items and os.path.realpath(items[-1].get("path", "")) == path:
        return False
    meta = _palette_meta()
    items.append({
        "path": path,
        "name": os.path.basename(path),
        "seen_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "accent": meta.get("accent", ""),
    })
    _save_history(items)
    return True


def _load_favorites():
    data = _read_json(FAVORITES_FILE, {"version": 1, "items": []})
    items = data.get("items", []) if isinstance(data, dict) else []
    return [item for item in items if isinstance(item, dict) and item.get("path")]


def _save_favorites(items):
    seen = set()
    cleaned = []
    for item in items:
        path = os.path.realpath(str(item.get("path", "")))
        if not path or path in seen:
            continue
        seen.add(path)
        copy_item = dict(item)
        copy_item["path"] = path
        cleaned.append(copy_item)
    _write_private_json(FAVORITES_FILE, {"version": 1, "items": cleaned})


def _is_favorite(path):
    if not path:
        return False
    target = os.path.realpath(path)
    return any(os.path.realpath(item["path"]) == target for item in _load_favorites())


def _theme_scope():
    scope = str(runtime.load_config().get("theme_scope", "all")).lower()
    return scope if scope in VALID_THEME_SCOPES else "all"


def _live_sync_allowed(command, scope=None):
    scope = scope or _theme_scope()
    try:
        name = os.path.basename(str(command[0]))
    except (TypeError, IndexError):
        return True
    if scope == "all":
        return True
    terminal = {
        "omarchy-restart-terminal",
        "omarchy-theme-set-foot",
        "omarchy-theme-set-tmux",
        "omarchy-restart-btop",
    }
    editors = {
        "omarchy-theme-set-vscode",
        "omarchy-theme-set-obsidian",
        "omarchy-restart-opencode",
        "omarchy-restart-helix",
    }
    desktop = {"omarchy-theme-set-browser", "omarchy-theme-set-gnome"}
    known_live_sync = terminal | editors | desktop
    # Unknown subprocesses are never suppressed. The scope is deliberately a
    # narrow policy for Aura's known post-theme refresh helpers only.
    if name not in known_live_sync:
        return True
    if scope == "shell":
        return False
    if scope == "terminals":
        return name in terminal
    if scope == "editors":
        return name in terminal or name in editors
    return True


class _SkippedProcess:
    pid = 0
    returncode = 0

    def poll(self):
        return 0

    def wait(self, timeout=None):
        return 0


def _apply_with_extras():
    """Apply one wallpaper while enforcing live-app scope and recording history."""
    original_popen = subprocess.Popen
    scope = _theme_scope()

    def scoped_popen(command, *args, **kwargs):
        if not _live_sync_allowed(command, scope):
            core.log(f"Theme scope '{scope}' skipped live sync: {os.path.basename(str(command[0]))}")
            return _SkippedProcess()
        return original_popen(command, *args, **kwargs)

    subprocess.Popen = scoped_popen
    try:
        result = _ORIGINAL_APPLY()
    finally:
        subprocess.Popen = original_popen
    _record_history()
    return result


_ORIGINAL_APPLY = core.apply_next_wallpaper
core.apply_next_wallpaper = _apply_with_extras


def _force_wallpaper(path):
    target = os.path.realpath(os.path.expanduser(str(path)))
    if not os.path.isfile(target):
        print(f"Wallpaper no longer exists: {target}")
        return 1
    if not core.valid_wallpaper(target):
        print(f"Wallpaper is not a valid Aura wallpaper: {target}")
        return 1

    original_collect = core.collect_local_wallpapers
    original_load = core.load_config
    cfg = runtime.load_config()
    forced_cfg = copy.deepcopy(cfg)
    forced_cfg["stream_online"] = False
    core.collect_local_wallpapers = lambda validate=False, max_age=30.0: [target]
    core.load_config = lambda: copy.deepcopy(forced_cfg)
    try:
        _apply_with_extras()
    finally:
        core.collect_local_wallpapers = original_collect
        core.load_config = original_load
    return 0


def history_cmd(args):
    sub = args[0].lower() if args else "list"
    items = _load_history()
    if sub in {"list", "ls"}:
        if not items:
            print("No wallpaper history yet.")
            return 0
        current = os.path.realpath(_current_wallpaper()) if _current_wallpaper() else ""
        for index, item in enumerate(reversed(items), 1):
            marker = " *" if os.path.realpath(item["path"]) == current else ""
            print(f"{index:>3}. {item.get('name') or os.path.basename(item['path'])}{marker}  {item['path']}")
        return 0
    if sub in {"previous", "prev", "undo"}:
        current = os.path.realpath(_current_wallpaper()) if _current_wallpaper() else ""
        candidates = [item for item in reversed(items) if os.path.realpath(item["path"]) != current]
        if not candidates:
            print("No previous wallpaper is available.")
            return 1
        return _force_wallpaper(candidates[0]["path"])
    if sub == "apply":
        if len(args) < 2 or not args[1].isdigit():
            print("Usage: aura-cycler history apply <number>")
            return 2
        newest = list(reversed(items))
        index = int(args[1]) - 1
        if index < 0 or index >= len(newest):
            print("History number is out of range.")
            return 2
        return _force_wallpaper(newest[index]["path"])
    if sub == "clear":
        _save_history([])
        print("Wallpaper history cleared. Favorites were not changed.")
        return 0
    print("Usage: aura-cycler history {list|previous|apply <number>|clear}")
    return 2


def favorites_cmd(args):
    sub = args[0].lower() if args else "list"
    items = _load_favorites()
    if sub in {"list", "ls"}:
        if not items:
            print("No favorite wallpapers yet.")
            return 0
        for index, item in enumerate(items, 1):
            missing = " [missing]" if not os.path.isfile(item["path"]) else ""
            print(f"{index:>3}. {item.get('name') or os.path.basename(item['path'])}{missing}  {item['path']}")
        return 0
    if sub in {"toggle", "add-current"}:
        current = _current_wallpaper()
        if not current:
            print("No active wallpaper detected.")
            return 1
        target = os.path.realpath(current)
        existing = next((i for i, item in enumerate(items) if os.path.realpath(item["path"]) == target), None)
        if existing is not None:
            removed = items.pop(existing)
            _save_favorites(items)
            print(f"Removed favorite: {removed.get('name') or os.path.basename(target)}")
        else:
            items.append({
                "path": target,
                "name": os.path.basename(target),
                "added_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                "accent": _palette_meta().get("accent", ""),
            })
            _save_favorites(items)
            print(f"Added favorite: {os.path.basename(target)}")
        return 0
    if sub == "apply":
        if len(args) < 2 or not args[1].isdigit():
            print("Usage: aura-cycler favorites apply <number>")
            return 2
        index = int(args[1]) - 1
        if index < 0 or index >= len(items):
            print("Favorite number is out of range.")
            return 2
        return _force_wallpaper(items[index]["path"])
    if sub in {"remove", "rm"}:
        if len(args) < 2 or not args[1].isdigit():
            print("Usage: aura-cycler favorites remove <number>")
            return 2
        index = int(args[1]) - 1
        if index < 0 or index >= len(items):
            print("Favorite number is out of range.")
            return 2
        removed = items.pop(index)
        _save_favorites(items)
        print(f"Removed favorite: {removed.get('name') or os.path.basename(removed['path'])}")
        return 0
    print("Usage: aura-cycler favorites {list|toggle|apply <number>|remove <number>}")
    return 2


def theme_scope_cmd(args):
    cfg = runtime.load_config()
    if not args or args[0] in {"status", "get"}:
        print(cfg.get("theme_scope", "all"))
        return 0
    scope = args[0].lower()
    if scope not in VALID_THEME_SCOPES:
        print("Theme scope must be one of: " + ", ".join(VALID_THEME_SCOPES))
        return 2
    cfg["theme_scope"] = scope
    runtime.save_config(cfg)
    print(f"Theme live-sync scope: {scope}")
    return 0


def scene_cmd(args):
    if not args or args[0] in {"list", "ls"}:
        current = runtime.load_config().get("scene", "custom")
        for name in SCENES:
            marker = " *" if name == current else ""
            print(f"{name}{marker}")
        return 0
    if args[0] in {"status", "current"}:
        print(runtime.load_config().get("scene", "custom"))
        return 0
    if args[0] != "apply" or len(args) < 2:
        print("Usage: aura-cycler scene {list|status|apply <focus|gaming|battery|ambient>}")
        return 2
    name = args[1].lower()
    preset = SCENES.get(name)
    if not preset:
        print("Unknown scene: " + name)
        return 2
    cfg = runtime.load_config()
    for key, value in preset.items():
        if key == "gpu_guard.auto_protect":
            guard = dict(cfg.get("gpu_guard") or {})
            guard["auto_protect"] = bool(value)
            cfg["gpu_guard"] = guard
        else:
            cfg[key] = value
    # Scenes intentionally never enable weather/networking automatically.
    cfg["scene"] = name
    runtime.save_config(cfg)
    print(f"Applied Aura scene: {name}")
    return 0


def privacy_cmd(args):
    cfg = runtime.load_config()
    full = bool(args and args[0] == "--full")
    manual = cfg.get("manual_location") if cfg.get("location_mode") == "manual" else None
    payload = {
        "weather_sync": bool(cfg.get("weather_sync", False)),
        "online_wallpapers": bool(cfg.get("stream_online", False)),
        "location_mode": cfg.get("location_mode", "off"),
        "location_cached": bool(cfg.get("location_cache")),
        "manual_location_configured": bool(manual),
        "network_enabled": bool(cfg.get("weather_sync", False) or cfg.get("stream_online", False)),
    }
    if full and manual:
        payload["manual_location"] = manual
    print(json.dumps(payload, indent=2, sort_keys=True))
    return 0


def config_cmd(args):
    sub = args[0] if args else "show"
    if sub not in {"show", "export"}:
        print("Usage: aura-cycler config {show|export [--private]}")
        return 2
    cfg = copy.deepcopy(runtime.load_config())
    private = "--private" in args[1:]
    if not private:
        cfg.pop("location_cache", None)
        if cfg.get("manual_location"):
            cfg["manual_location"] = {"configured": True, "redacted": True}
    print(json.dumps(cfg, indent=2, sort_keys=True))
    return 0


def cache_cmd(args):
    sub = args[0].lower() if args else "status"
    palette_dir = Path(core.PALETTE_CACHE_DIR)
    files = list(palette_dir.glob("*.json")) if palette_dir.is_dir() else []
    size = sum(path.stat().st_size for path in files if path.is_file())
    if sub == "status":
        print(json.dumps({
            "palette_entries": len(files),
            "palette_bytes": size,
            "palette_dir": str(palette_dir),
        }, indent=2))
        return 0
    if sub == "prune-palettes":
        days = 30
        if len(args) > 1:
            try:
                days = max(1, int(args[1]))
            except ValueError:
                print("Usage: aura-cycler cache prune-palettes [days]")
                return 2
        cutoff = time.time() - days * 86400
        removed = 0
        for path in files:
            try:
                if path.stat().st_mtime < cutoff:
                    path.unlink()
                    removed += 1
            except OSError:
                pass
        print(f"Pruned {removed} palette cache entries older than {days} days.")
        return 0
    print("Usage: aura-cycler cache {status|prune-palettes [days]}")
    return 2


def _doctor_checks():
    checks = []

    def add(name, ok, detail, severity="fail"):
        checks.append({
            "name": name,
            "ok": bool(ok),
            "severity": "ok" if ok else severity,
            "detail": str(detail),
        })

    add("runtime", RUNTIME_PATH.is_file(), RUNTIME_PATH)
    add("core", (HERE / "aura-cycler-core").is_file(), HERE / "aura-cycler-core")
    add("manifest", (HERE.parent / "manifest.json").is_file(), HERE.parent / "manifest.json")
    for module_name in ("PIL", "numpy", "sklearn", "materialyoucolor"):
        found = importlib.util.find_spec(module_name) is not None
        add(f"python:{module_name}", found, "installed" if found else "missing")
    for binary in ("omarchy-shell", "omarchy-theme-set-templates"):
        found = shutil.which(binary)
        add(f"command:{binary}", bool(found), found or "not found")
    # Loading performs privacy-permission repair before the check below.
    cfg = runtime.load_config()
    cfg_path = Path(core.CONFIG_FILE)
    if cfg_path.exists():
        mode = cfg_path.stat().st_mode & 0o777
        add("config-permissions", mode == 0o600, oct(mode), "warn")
    else:
        add("config-permissions", True, "not created yet")
    add("location-mode", cfg.get("location_mode") in {"off", "auto", "manual"}, cfg.get("location_mode"))
    add("theme-scope", _theme_scope() in VALID_THEME_SCOPES, _theme_scope())
    wallpaper = _current_wallpaper()
    add("active-wallpaper", bool(wallpaper and os.path.isfile(wallpaper)), wallpaper or "none", "warn")
    folders = cfg.get("custom_folders", [])
    existing = [path for path in folders if os.path.isdir(os.path.expanduser(str(path)))]
    add("wallpaper-folders", bool(existing), f"{len(existing)}/{len(folders)} exist", "warn")
    return checks


def doctor_cmd(args):
    checks = _doctor_checks()
    failures = [c for c in checks if not c["ok"] and c["severity"] == "fail"]
    warnings = [c for c in checks if not c["ok"] and c["severity"] == "warn"]
    if "--json" in args:
        print(json.dumps({
            "version": VERSION,
            "ok": not failures,
            "failures": len(failures),
            "warnings": len(warnings),
            "checks": checks,
        }, indent=2))
    else:
        for check in checks:
            icon = "OK" if check["ok"] else ("WARN" if check["severity"] == "warn" else "FAIL")
            print(f"[{icon:4}] {check['name']}: {check['detail']}")
        print(f"\nAura doctor: {len(failures)} failure(s), {len(warnings)} warning(s)")
    return 1 if failures else 0


def _status_json_enriched():
    buffer = io.StringIO()
    with contextlib.redirect_stdout(buffer):
        runtime.status_json()
    payload = None
    for line in reversed(buffer.getvalue().strip().splitlines()):
        try:
            candidate = json.loads(line)
            if isinstance(candidate, dict):
                payload = candidate
                break
        except (ValueError, TypeError):
            continue
    if payload is None:
        print(buffer.getvalue(), end="")
        return 1
    wallpaper = payload.get("wallpaper") or _current_wallpaper()
    if wallpaper:
        _record_history(wallpaper)
    cfg = runtime.load_config()
    payload["version"] = VERSION
    payload["theme_scope"] = _theme_scope()
    payload["scene"] = cfg.get("scene", "custom")
    payload["history_count"] = len(_load_history())
    payload["favorites_count"] = len(_load_favorites())
    payload["favorite"] = _is_favorite(wallpaper)
    payload["privacy"] = {
        "location_mode": cfg.get("location_mode", "off"),
        "network_enabled": bool(cfg.get("weather_sync", False) or cfg.get("stream_online", False)),
    }
    print(json.dumps(payload))
    return 0


def _dispatch():
    action = sys.argv[1] if len(sys.argv) > 1 else "start"
    args = sys.argv[2:]

    if action in {"version", "--version", "-V"}:
        print(VERSION)
        return 0
    if action == "status-json":
        return _status_json_enriched()
    if action in {"history", "recent"}:
        return history_cmd(args)
    if action in {"previous", "undo"}:
        return history_cmd(["previous"])
    if action in {"favorites", "favourites"}:
        return favorites_cmd(args)
    if action in {"favorite", "favourite"}:
        return favorites_cmd(["toggle"])
    if action in {"theme-scope", "scope"}:
        return theme_scope_cmd(args)
    if action in {"scene", "scenes"}:
        return scene_cmd(args)
    if action == "privacy":
        return privacy_cmd(args)
    if action == "config":
        return config_cmd(args)
    if action == "cache":
        return cache_cmd(args)
    if action in {"doctor", "diagnose", "self-check"}:
        return doctor_cmd(args)

    runtime._dispatch()
    return 0


def __getattr__(name):
    if hasattr(runtime, name):
        return getattr(runtime, name)
    if hasattr(core, name):
        return getattr(core, name)
    raise AttributeError(name)


if __name__ == "__main__":
    raise SystemExit(_dispatch())
